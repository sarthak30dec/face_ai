# Copy to .env and adjust. All paths default to locations inside the project.
# FACE_AI_ROOT=/path/to/face_ai
# FACE_AI_DATA_DIR=/Volumes/big_disk/face_ai_data      # datasets (~4 GB extracted)
# FACE_AI_MODELS_DIR=/path/to/models
# FACE_AI_GALLERY_DIR=/secure/encrypted/volume/gallery  # private enrollment gallery (biometric data)
# FACE_AI_LOG_LEVEL=INFO
